# Google Sheets Configuration
# Copy this file to .env and fill in your actual values

# Set to 'false' to load from Google Sheets (set to 'true' only for testing with sample data)
USE_SAMPLE_DATA=false

# Your Google Sheets Spreadsheet ID
# Find this in your Google Sheets URL: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your-spreadsheet-id-here

# Google Service Account Credentials (JSON string)
# Get this from Google Cloud Console → Service Accounts → Create Key (JSON format)
# IMPORTANT: This should be a single-line JSON string. Escape quotes properly.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Optional: Mapbox Access Token (for maps)
MAPBOX_ACCESS_TOKEN=

# Optional: SendGrid API Key (for email notifications)
SENDGRID_API_KEY=

# Optional: Upstash Redis for rate limiting on form endpoints (lib/rate-limit.ts).
# When unset, an in-memory per-Lambda limiter is used (best-effort only).
# Create a database at https://console.upstash.com and copy the REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shop photos in Cloudflare R2. R2_PUBLIC_URL (the bucket's r2.dev URL) is needed
# at build time on Vercel: next.config.mjs rewrites /photos/* to it.
# The rest are only for scripts/fetch-google-photos.mjs (run locally).
R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Google Places API (New), for scripts/fetch-google-photos.mjs
GOOGLE_PLACES_API_KEY=
